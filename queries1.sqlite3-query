-- database: ./database.db

CREATE TABLE `users` (
  `user_id` INTEGER,
  `username` VARCHAR (20),
  `email` VARCHAR,
  `password` VARCHAR,
  PRIMARY KEY (`user_id`),
  UNIQUE (`username`, `email`)
);



CREATE TABLE `products` (
  `product_id` INTEGER,
  `product_name` VARCHAR (20),
  `description` VARCHAR (100),
  `price_suggested` INTEGER,
  `seller_key` INTEGER,
  `image_url` VARCHAR,
  `date_posted` DATE,
  `status` TEXT,
  `health_hazards` VARCHAR,
  `likes` INTEGER,
  PRIMARY KEY (`product_id`),
  FOREIGN KEY (`seller_key`)
      REFERENCES `users`(`user_id`)
);

CREATE TABLE `offers` (
  `offer_id` INTEGER,
  `product_key` INTEGER,
  `seller_key` INTEGER,
  `offer_price` INTEGER,
  `message` VARCHAR,
  `date_sent` DATE,
  `status` TEXT,
  `byer_key` INTEGER,
  PRIMARY KEY (`offer_id`),
  FOREIGN KEY (`seller_key`)
      REFERENCES `users`(`user_id`),
  FOREIGN KEY (`byer_key`)
      REFERENCES `users`(`user_id`),
  FOREIGN KEY (`product_key`)
      REFERENCES `products`(`product_id`)
);

CREATE TABLE `locations` (
  `location_id` INTEGER,
  `location_name` VARCHAR (20),
  `description` VARCHAR (50),
  `x_co` VARCHAR,
  `y_co` VARCHAR,
  PRIMARY KEY (`location_id`)
);

CREATE TABLE `meetups` (
  `meetup_id` INTEGER,
  `offer_key` INTEGER,
  `location_key` INTEGER,
  `meetup_time` DATE,
  `status` TEXT,
  PRIMARY KEY (`meetup_id`),
  FOREIGN KEY (`offer_key`)
      REFERENCES `offers`(`offer_id`),
  FOREIGN KEY (`location_key`)
      REFERENCES `locations`(`location_id`)
);

CREATE TABLE `alert_type` (
  `type_id` INTEGER,
  `type_desc` VARCHAR (20),
  PRIMARY KEY (`type_id`)
);

CREATE TABLE `alerts` (
  `alert_id` INTEGER,
  `user_key` INTEGER,
  `offer_key` INTEGER,
  `alert_type` INTEGER,
  `message` VARCHAR,
  `date_created` DATE,
  `status` TEXT,
  PRIMARY KEY (`alert_id`),
  FOREIGN KEY (`alert_type`)
      REFERENCES `alert_type`(`type_id`),
  FOREIGN KEY (`user_key`)
      REFERENCES `users`(`user_id`),
  FOREIGN KEY (`offer_key`)
      REFERENCES `offers`(`offer_id`)
);


